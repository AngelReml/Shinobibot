# Configuración de Modelos e IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4-5
# OPENROUTER_VISION_MODEL=anthropic/claude-haiku-4-5

# Modo y Configuración del Compactor
# Modos válidos: heuristic | llm | auto
SHINOBI_COMPACTOR_MODE=heuristic
SHINOBI_COMPACTOR_BUDGET_TOKENS=32000
SHINOBI_COMPACTOR_THRESHOLD_RATIO=0.75
SHINOBI_COMPACTOR_FLOOR_RATIO=0.40

# Sistema de Aprobación de Herramientas
# Modos válidos: smart | on | off
SHINOBI_APPROVAL_MODE=smart
SHINOBI_APPROVAL_TIMEOUT_MS=120000
# Acción al expirar el timeout de aprobación: 'deny' (default, seguro) | 'approve' (legacy)
# SHINOBI_APPROVAL_TIMEOUT_ACTION=deny

# Capa de integridad en runtime: 'flag' (default, detecta+registra) | 'enforce' (bloquea) | 'off' (desactivado)
# SHINOBI_INTEGRITY=flag

# Integración Sandbox E2B Cloud
E2B_API_KEY=

# Background Review (Motor 1 del bucle de aprendizaje)
# Modelo auxiliar barato para revisar misiones. Default: anthropic/claude-haiku-4-5
# SHINOBI_REVIEW_MODEL=anthropic/claude-haiku-4-5
# Deshabilitar el Motor 1: SHINOBI_REVIEW_ENABLED=0 (habilitado por defecto)

# Skill Curator (Motor 2 — limpieza de la librería de skills)
# SHINOBI_CURATOR_ENABLED=1
# SHINOBI_CURATOR_INTERVAL_HOURS=168
# SHINOBI_CURATOR_STALE_DAYS=30
# SHINOBI_CURATOR_ARCHIVE_DAYS=90

# Detector de progreso semántico (loop detector capa 3)
# Desactivado por defecto (consume tokens). Activar con =1.
# SHINOBI_PROGRESS_DETECTION=1
# Modelo judge (formato provider:model). Default: groq:llama-3.3-70b-versatile
# SHINOBI_PROGRESS_JUDGE=groq:llama-3.3-70b-versatile

# Kagemusha (investigación nocturna)
# KAGEMUSHA_BULK_MODEL=glm-4-flash
# KAGEMUSHA_JUDGE_MODEL=

# Canales de Comunicación (Opcional)
# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (IMAP/SMTP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
