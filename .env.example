# Configuración de Modelos e IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Varias claves de Anthropic (separadas por comas). Si una se queda sin cupo (429) o deja de valer (401/403)
# se prueba la siguiente; la que funciona se mantiene para no perder la caché.
# ANTHROPIC_API_KEYS=
# Caché de prompt de Anthropic: ON por defecto (abarata las misiones de muchos pasos). Apagar con 0.
# SHINOBI_ANTHROPIC_CACHE=1
# Tamaño máximo de cada respuesta (por defecto 8192) y espera máxima por llamada en ms (por defecto 180000).
# SHINOBI_ANTHROPIC_MAX_TOKENS=8192
# SHINOBI_LLM_TIMEOUT_MS=180000
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4-5
# OPENROUTER_VISION_MODEL=anthropic/claude-haiku-4-5
# GROQ_API_KEY=

# Modo y Configuración del Compactor
# Modos válidos: heuristic | llm | auto
SHINOBI_COMPACTOR_MODE=heuristic
SHINOBI_COMPACTOR_BUDGET_TOKENS=32000
SHINOBI_COMPACTOR_THRESHOLD_RATIO=0.75
SHINOBI_COMPACTOR_FLOOR_RATIO=0.40

# Objetivo fijo (/goal <meta>): el agente sigue hasta que un juez barato da la meta por cumplida.
# Tope de turnos por objetivo (por defecto 20) y modelo del juez (por defecto, el del proveedor activo).
# SHINOBI_GOAL_MAX_TURNS=20
# SHINOBI_GOAL_JUDGE_MODEL=

# Contexto del proyecto: al empezar una misión se lee SHINOBI.md, AGENTS.md o CLAUDE.md de la carpeta de trabajo
# (el primero que exista). ON por defecto; apagar con 0. Tamaño máximo en caracteres (por defecto 8000).
# SHINOBI_CONTEXT_FILES=1
# SHINOBI_CONTEXT_FILE_MAX_CHARS=8000

# Sistema de Aprobación de Herramientas
# Modos válidos: smart | on | off
SHINOBI_APPROVAL_MODE=smart
SHINOBI_APPROVAL_TIMEOUT_MS=120000
# Acción al expirar el timeout de aprobación: 'deny' (default, seguro) | 'approve' (legacy)
# SHINOBI_APPROVAL_TIMEOUT_ACTION=deny

# Capa de integridad en runtime: 'flag' (default, detecta+registra) | 'enforce' (bloquea) | 'off' (desactivado)
# SHINOBI_INTEGRITY=flag

# Integración Sandbox E2B Cloud
E2B_API_KEY=

# Background Review (Motor 1 del bucle de aprendizaje)
# Modelo auxiliar barato para revisar misiones. Default: anthropic/claude-haiku-4-5
# SHINOBI_REVIEW_MODEL=anthropic/claude-haiku-4-5
# Deshabilitar el Motor 1: SHINOBI_REVIEW_ENABLED=0 (habilitado por defecto)

# Skill Curator (Motor 2 — limpieza de la librería de skills)
# SHINOBI_CURATOR_ENABLED=1
# SHINOBI_CURATOR_INTERVAL_HOURS=168
# SHINOBI_CURATOR_STALE_DAYS=30
# SHINOBI_CURATOR_ARCHIVE_DAYS=90

# Detector de progreso semántico (loop detector capa 3)
# Desactivado por defecto (consume tokens). Activar con =1.
# SHINOBI_PROGRESS_DETECTION=1
# Modelo judge (formato provider:model). Default: groq:llama-3.3-70b-versatile
# SHINOBI_PROGRESS_JUDGE=groq:llama-3.3-70b-versatile

# Kagemusha (investigación nocturna)
# KAGEMUSHA_BULK_MODEL=glm-4-flash
# KAGEMUSHA_JUDGE_MODEL=

# Canales de Comunicación (Opcional)
# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (IMAP/SMTP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Mejoras tomadas de Hermes Agent (todas opcionales) ---
# Pensar antes de responder (solo Anthropic): off | low | medium | high
# SHINOBI_REASONING=off
# Panel de consult_models: "proveedor:modelo,proveedor:modelo"
# SHINOBI_MOA_MODELS=anthropic:claude-haiku-4-5,anthropic:claude-sonnet-4-5
# Diario buscable de conversaciones (session_search). 0 = apagado.
# SHINOBI_SESSION_LOG=1
# Copias para /rollback. 0 = apagado.
# SHINOBI_CHECKPOINTS=1
# Ganchos del usuario (hooks.json en el directorio de datos). 0 = apagados.
# SHINOBI_HOOKS=1
# Carpeta "puente" de tu copia del radar (repo agentesdk), para /puente
# SHINOBI_PUENTE_DIR=
# Modelo para el adversario y el juez del puente (por defecto, el del agente)
# SHINOBI_PUENTE_MODEL=
