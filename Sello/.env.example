# Sello — environment template. Copy to .env (gitignored) and fill as needed.
# F0 needs NO secrets to run. These are placeholders for later phases.

# Directory where the ed25519 verifier keypair lives (gitignored).
SELLO_KEYS_DIR=./keys

# Canonical bank path.
SELLO_BANK=./bank/pilot_agentic_v1.jsonl

# Adapter subprocess timeout (ms).
SELLO_ADAPTER_TIMEOUT_MS=30000
