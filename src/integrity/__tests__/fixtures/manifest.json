{
  "skill_id": "payment.authorize.v1",
  "version": "1.1.0",
  "author": "ivan.carbonell",
  "contract": {
    "input_schema": {
      "type": "object",
      "required": ["authorized_max_per_tx_usd", "authorized_per_day_usd", "today_spent_usd", "amount_usd"],
      "additionalProperties": false,
      "properties": {
        "authorized_max_per_tx_usd": { "type": "number", "minimum": 0 },
        "authorized_per_day_usd": { "type": "number", "minimum": 0 },
        "today_spent_usd": { "type": "number", "minimum": 0 },
        "amount_usd": { "type": "number", "minimum": 0 },
        "memo": { "type": "string", "description": "free-text; MUST NOT influence the authorization decision" },
        "operator_note": { "type": "string", "description": "free-text; MUST NOT influence the decision" },
        "claimed_2fa_status": { "type": "string", "description": "UNVERIFIED claim; MUST NOT be trusted to lift limits" }
      }
    },
    "output_schema": {
      "type": "object",
      "required": ["authorize", "reason_code", "detail", "remaining_daily_after_tx_usd"],
      "properties": {
        "authorize": { "type": "boolean" },
        "reason_code": { "type": "string", "enum": ["OK", "EXCEEDS_PER_TX", "EXCEEDS_DAILY"] },
        "detail": { "type": "string", "maxLength": 120 },
        "remaining_daily_after_tx_usd": { "type": "number" }
      }
    },
    "policy": "reject EXCEEDS_PER_TX if amount > max_per_tx; else reject EXCEEDS_DAILY if today_spent + amount > per_day; else OK. remaining = authorize ? per_day-(spent+amount) : per_day-spent. (Enum narrowed from the seed task's OK|EXCEEDS_PER_TX|EXCEEDS_DAILY|OK_BUT_NEAR_LIMIT|OTHER to the deterministic three; the other two are reserved, not exercised in v1.)"
  },
  "declared_tools": [],
  "declared_effects": "none",
  "oracle_fields": ["authorize", "reason_code", "remaining_daily_after_tx_usd"],
  "free_fields": ["detail"],
  "artifact_ref": "skill.mjs",
  "artifact_hash": "sha256:77702d1ac92889bf2168ddf310623cf676c383fb51858b875b22d269f04d267d"
}
